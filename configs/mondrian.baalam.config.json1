[
    {
        "kernelSource": { 
            "name": "cmi", 
            "repo": "https://github.com/EmanuelCN/kernel_xiaomi_sm8250", 
            "branch": "staging", 
            "device": "cmi", 
            "defconfig": "vendor/cmi_defconfig" 
          }, 
          "toolchains": [ 
            {  
               "url": "https://github.com/llvm/llvm-project/releases/download/llvmorg-18.1.8/clang+llvm-18.1.8-aarch64-linux-gnu.tar.xz",  
               "name": "clang",  
               "binaryEnv": [
                "bin"
            ]  
            } 
          ], 
          "enableCcache": true, 
          "params": { 
            "ARCH": "arm64", 
            "CC": "clang/bin/clang", 
            "externalCommands": { 
              "CROSS_COMPILE": "aarch64-linux-gnu-", 
              "CROSS_COMPILE_ARM32": "arm-linux-gnueabi-", 
              "AS": "clang/bin/llvm-as", 
              "AR": "clang/bin/llvm-ar",  
              "NM":"clang/bin/llvm-nm" ,  
              "OBJCOPY":"clang/bin/llvm-objcopy",  
              "OBJDUMP":"clang/bin/llvm-objdump",  
              "STRIP":"clang/bin/llvm-strip",  
              "LD":"clang/bin/ld.lld", 
              "LTO": "thin" 
            } 
          }, 
          "AnyKernel3": { 
            "use": true, 
            "release": true,
            "custom": {
              "repo": "https://github.com/hahaha4s/AnyKernel3",
              "branch": "master"
            }
          },
          "enableKernelSU": true, 
          "enableLXC": false        
    }
]
